<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Copy whisper folder into output dir so the app can find it at runtime -->
  <Target Name="CopyWhisper" AfterTargets="Build">
    <ItemGroup>
      <WhisperFiles Include="$(MSBuildProjectDirectory)\whisper\**\*"
                    Exclude="$(MSBuildProjectDirectory)\whisper\Release\**" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperFiles)"
          DestinationFiles="@(WhisperFiles->'$(OutDir)whisper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>